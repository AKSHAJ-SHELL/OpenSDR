# --- LLM (BYOK) ---
ANTHROPIC_API_KEY=            # leave empty when using ollama / mock
LLM_PROVIDER=ollama           # anthropic | ollama | mock
ANTHROPIC_MODEL=claude-sonnet-4-6
# Host processes: http://localhost:11434
# Docker api/worker: http://host.docker.internal:11434  (Ollama on the Mac/host)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b

# --- Embeddings ---
# Use hash for local/demo (no API). voyage for real ICP similarity.
EMBEDDING_PROVIDER=hash       # voyage | hash
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5-lite

# --- Infra ---
# Host processes talking to compose postgres/redis:
DATABASE_URL=postgresql+psycopg://craftsman:craftsman@localhost:5432/craftsman
REDIS_URL=redis://localhost:6379/0
POSTGRES_PASSWORD=craftsman

# --- Secrets ---
# Fernet key for encrypting mailbox SMTP/IMAP credentials at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CRAFTSMAN_SECRET_KEY=

# --- Sending / compliance ---
UNSUBSCRIBE_BASE_URL=http://localhost:8000
PHYSICAL_ADDRESS="123 Main St, San Francisco, CA 94105"
GDPR_MODE=false
ICP_THRESHOLD=0.55

# --- Multi-channel tasks (M3) ---
# LinkedIn/call steps queue validated tasks for a human — nothing is automated.
# Business days until a task is due (overdue after; sequences hold by default):
TOUCH_TASK_DUE_DAYS=3
# Channel validator caps (⛔ product knobs — changing them is a human decision):
LINKEDIN_NOTE_MAX_CHARS=280
CALL_OPENER_MAX_WORDS=25
CALL_PAIN_MAX_WORDS=20
CALL_OBJECTION_MAX_WORDS=40
# Optional BYO-Twilio click-to-dial: rings YOUR phone first, then dials the lead.
# All four required; unset = the task card falls back to a plain tel: link.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_OPERATOR_NUMBER=

# --- Notifications ---
SLACK_WEBHOOK_URL=

# --- Local sandbox (Mailpit) ---
# Inbox poller reads Mailpit's HTTP API (not IMAP).
# Host worker:  http://localhost:8025
# Docker worker: overridden to http://mailpit:8025 in docker-compose.yml
MAILPIT_URL=http://localhost:8025

# --- Next.js dashboard auth ---
# The dashboard signs in a single admin and talks to the API with a server-held
# API key that is never sent to the browser. Create the key first:
#   python -m craftsman.create_key --name dashboard --scopes read operate
# Then set it here (also settable in web/.env.local for `next dev`):
CRAFTSMAN_API_KEY=
# Login password hash. Generate with:  node web/scripts/hash-password.mjs '<password>'
DASHBOARD_PASSWORD_HASH=
# Secret that signs the session cookie. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_SESSION_SECRET=
# API base the dashboard calls (server-side). Browser never calls the API directly.
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
